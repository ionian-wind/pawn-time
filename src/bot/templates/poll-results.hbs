<b>{{title}}</b>
{{#each dateGroups}}
<table bordered compact>
  <tr>
    <td><b>{{date}}</b></td>
    <td>✓</td>
    <td>~</td>
    <td>✗</td>
  </tr>
  {{#each rows}}
  <tr>
    <td><b>{{interval}}</b></td>
    <td>{{{yes}}}</td>
    <td>{{{maybe}}}</td>
    <td>{{{no}}}</td>
  </tr>
  {{/each}}
</table>
{{/each}}
<i>{{participants}}</i>
