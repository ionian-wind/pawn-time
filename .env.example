# Application environment (development, test, production)
NODE_ENV=development

# The port the HTTP server will listen on
PORT=3000

# SQLite database file path (relative to project root)
# Use ':memory:' for an in-memory database
DATABASE_PATH=data/pawn-time.db

# Telegram Bot token (from @BotFather). The bot front-end is only started
# when this is set. Keep it secret; never commit the real token.
TELEGRAM_BOT_TOKEN=

# Logging verbosity for the bot: debug | info | warn | error | silent
LOG_LEVEL=info
